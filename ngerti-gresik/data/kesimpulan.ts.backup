export interface NilaiBudaya {
  icon: string;
  title: string;
  desc: string;
  color: string;
  verified: boolean;
  source?: {
    title: string;
    url: string;
  };
}

export interface KonflikSejarah {
  tahun: string;
  judul: string;
  icon: string;
  deskripsi: string;
  dampak: string[];
  pembelajaran: string;
  verified: boolean;
  source: {
    title: string;
    url: string;
  };
}

export interface Pernyataan {
  type: "benar" | "salah";
  text: string;
  alasan: string;
  source?: {
    title: string;
    url: string;
  };
}

export interface Solusi {
  icon: string;
  label: string;
}

export interface Takeaway {
  icon: string;
  title: string;
  points: string[];
}

export interface PesanInti {
  title: string;
  content: string;
  highlight: string;
  icon: string;
}

export interface FinalMessage {
  title: string;
  content: string;
  tags: string[];
  icon: string;
}

